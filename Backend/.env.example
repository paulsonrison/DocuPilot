PORT=8000

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=15m

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# Sender address shown in outgoing emails.
# Development:  DocuPilot <onboarding@resend.dev>  (Resend shared sandbox domain)
# Production:   DocuPilot <noreply@yourdomain.com>  (your verified domain)
EMAIL_FROM=

# ── Development recipient override ───────────────────────────────────────────
# When NODE_ENV is not "production", all outgoing emails are redirected to this
# address instead of the actual user's email. Set it to the email address you
# have verified in your Resend account.
#
# Leave empty or remove entirely in production — it is ignored there.
DEV_EMAIL_RECIPIENT=

# ─────────────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000

CORS_ORIGIN=http://localhost:3000
